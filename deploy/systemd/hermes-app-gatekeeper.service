[Unit]
Description=Validate Hermes app platform requests and update the app registry
# Requests come from hermes-user, so a burst must not stop the path unit from firing.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/hermes-app-gatekeeper
RuntimeDirectory=hermes-apps
RuntimeDirectoryPreserve=yes

# Runs as root: it must write the root-owned registry, read a folder hermes-user owns, and see which
# user owns a listener. The capabilities below are the rest of what that takes.
# DAC_READ_SEARCH + SYS_PTRACE: ss -p reads other users' /proc/<pid>/fd.
# DAC_OVERRIDE + FOWNER: remove requests from hermes-user's folder. CHOWN: set group on results and entries.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_SYS_PTRACE CAP_FOWNER CAP_CHOWN
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/hermes-apps/inbox /srv/hermes-apps/results /var/lib/hermes-apps/registry
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# ss needs netlink in the host's network namespace, so PrivateNetwork can't be used. No IP traffic is needed.
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
IPAddressDeny=any
UMask=0077
TimeoutStartSec=60
